# 复制此文件为 .env 并填入实际值
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fwwb_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fwwb_db
DATABASE_SSL_MODE=auto
DATABASE_SSL_CA_FILE=

LLM_API_KEY=sk-xxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

RAGFLOW_API_URL=http://localhost:9380
RAGFLOW_API_KEY=ragflow-xxxxxxxx
RAGFLOW_DATASET_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 重排模型 ID（可选，留空则禁用精排，直接用向量相似度排序）
RAGFLOW_RERANK_ID=

# 安全（留空则开发环境跳过验证）
API_KEY=

# -----------------------------------------------------------------------
# 数据时间口径（全局统一，所有 Agent prompt 和默认查询范围均引用）
# -----------------------------------------------------------------------
DATA_TIME_START=2016-04-01
DATA_TIME_END=2016-12-31
DATA_TIMEZONE=UTC

DEBUG=true
APP_ENV=development

# -----------------------------------------------------------------------
# Startup Jobs（默认关闭，按部署环境显式开启）
# -----------------------------------------------------------------------
# 总开关：允许 API 进程注册后台周期任务。生产环境如由独立 worker/cron 承担任务，应保持 false。
ENABLE_STARTUP_JOBS=false
ENABLE_TOKEN_CLEANUP_JOB=false
ENABLE_ANOMALY_JOB=false
ENABLE_FORECAST_JOB=false
# 派工 SLA 分钟级扫描。若希望 API 进程自动写入临期/超时事件，请同时打开 ENABLE_STARTUP_JOBS。
ENABLE_DISPATCH_SLA_JOB=false
ANOMALY_JOB_INTERVAL_SECONDS=3600
FORECAST_JOB_INTERVAL_SECONDS=3600
DISPATCH_SLA_JOB_INTERVAL_SECONDS=60

# 自动派工执行默认关闭；开启后仍需 dry-run 命中阈值才会真正创建 dispatch_task。
# 2026-04-09 正式灰度口径：仅在目标环境确认后使用以下值开启；审批通过后不静默滞留。
# ENABLE_AUTO_DISPATCH_EXECUTION=true
# AUTO_DISPATCH_MIN_SCORE=105
# AUTO_DISPATCH_MIN_GAP=10
# AUTO_DISPATCH_REQUIRE_ON_DUTY=true
# AUTO_DISPATCH_ALLOWED_BUILDINGS=Fox_public_Henry
# AUTO_DISPATCH_ALLOWED_PRIORITIES=high
# AUTO_DISPATCH_ALLOWED_REQUIRED_SKILLS=hvac
# ENABLE_AUTO_DISPATCH_FALLBACK_EXECUTION=true
# AUTO_DISPATCH_FALLBACK_MIN_SCORE=95
# AUTO_DISPATCH_FALLBACK_ALLOW_STANDBY=false
# ENABLE_AUTO_DISPATCH_HALL_FALLBACK=true
# AUTO_DISPATCH_CREATE_HALL_ON_ROLLOUT_SKIP=true
# AUTO_DISPATCH_ALLOW_LOW_CONFIDENCE_IN_GREY=true
# AUTO_DISPATCH_ALLOW_HALL_FALLBACK_IN_GREY=true
ENABLE_AUTO_DISPATCH_EXECUTION=false
AUTO_DISPATCH_MIN_SCORE=110
AUTO_DISPATCH_MIN_GAP=10
AUTO_DISPATCH_REQUIRE_ON_DUTY=true
# 低置信兜底派工与大厅兜底也默认关闭。开启后仍需 AI 审批通过、工单待派工且无 current_dispatch。
ENABLE_AUTO_DISPATCH_FALLBACK_EXECUTION=false
AUTO_DISPATCH_FALLBACK_MIN_SCORE=95
AUTO_DISPATCH_FALLBACK_ALLOW_STANDBY=false
ENABLE_AUTO_DISPATCH_HALL_FALLBACK=false
AUTO_DISPATCH_CREATE_HALL_ON_ROLLOUT_SKIP=false
# 自动派工灰度范围。留空表示不按该维度限制；建议先只开放高置信场景。
AUTO_DISPATCH_ALLOWED_BUILDINGS=
AUTO_DISPATCH_ALLOWED_PRIORITIES=
AUTO_DISPATCH_ALLOWED_REQUIRED_SKILLS=
AUTO_DISPATCH_ALLOW_LOW_CONFIDENCE_IN_GREY=false
AUTO_DISPATCH_ALLOW_HALL_FALLBACK_IN_GREY=false

# 自动重派执行默认关闭。建议先只用 GET /api/work-orders/{ticket_id}/auto-reassign-evaluation 验证建议质量。
ENABLE_AUTO_REASSIGN_EXECUTION=false
AUTO_REASSIGN_MIN_SCORE=115
AUTO_REASSIGN_MIN_GAP=10
AUTO_REASSIGN_REQUIRE_ON_DUTY=true
AUTO_REASSIGN_REQUIRE_OVERDUE=true
AUTO_REASSIGN_MAX_ATTEMPT_NO=3
ENABLE_AUTO_REASSIGN_PHASE1_TRIGGER=false
ENABLE_AUTO_REASSIGN_SHADOW_MODE=false
# 自动重派自动执行灰度范围。留空表示不按该维度限制；建议第一轮只开放 assigned->overdue。
AUTO_REASSIGN_ALLOWED_BUILDINGS=
AUTO_REASSIGN_ALLOWED_PRIORITIES=
AUTO_REASSIGN_ALLOWED_REQUIRED_SKILLS=
AUTO_REASSIGN_TRIGGER_ASSIGNED_OVERDUE=true
AUTO_REASSIGN_TRIGGER_ACCEPTED_OVERDUE=true
AUTO_REASSIGN_ACCEPTED_MIN_PREVIOUS_REMINDERS=1
AUTO_REASSIGN_TRIGGER_ASSIGNEE_UNAVAILABLE=true

# -----------------------------------------------------------------------
# Redis Cache（用于首页 KPI / 告警 / 趋势等高频查询的分布式缓存）
# -----------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# 以 30 秒时间桶控制缓存刷新粒度（与前端刷新频率对齐）
CACHE_BUCKET_SECONDS=30

# 各接口缓存 TTL（秒）
CACHE_OVERVIEW_TTL_SECONDS=45
CACHE_ANOMALIES_RECENT_TTL_SECONDS=45
CACHE_ANOMALIES_SANKEY_TTL_SECONDS=45
CACHE_PREDICTIONS_RECENT_TTL_SECONDS=45
CACHE_BUILDING_ENERGY_TREND_TTL_SECONDS=300
CACHE_BUILDINGS_TTL_SECONDS=3600
CACHE_CHAT_SESSIONS_TTL_SECONDS=15
CACHE_CHAT_MESSAGES_TTL_SECONDS=15
CACHE_WORKORDERS_TTL_SECONDS=15

# stampede control：lock 的过期秒数 & 未拿到 lock 的等待秒数
CACHE_LOCK_EXPIRE_SECONDS=5
CACHE_LOCK_WAIT_SECONDS=1.0

# Redis 不可用时的本地降级缓存容量（条目数）与默认 TTL
CACHE_LOCAL_MAXSIZE=1024
CACHE_LOCAL_DEFAULT_TTL_SECONDS=60
